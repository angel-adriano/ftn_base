msgid "Product Category"
msgstr "Categoría del producto"

#. module: stock_no_negative
#: model:ir.model,name:stock_no_negative.model_stock_quant
msgid "Quants"
msgstr "Existencias"

#. module: stock_no_negative
#. odoo-python
#: code:addons/stock_no_negative/models/stock_quant.py:0
msgid ""
"You cannot validate this stock operation because the stock level of the "
"product '%(name)s' %(name_lot)s would become negative (%(q_quantity)s) on "
"the stock location '%(complete_name)s' and negative stock is not allowed for"
" this product and/or location."
msgstr "No se puede validar esta operación de stock porque el nivel de stock del producto '%(name)s' %(name_lot)s se volvería negativo (%(q_quantity)s) en la ubicación de stock '%(complete_name)s' y no se permite el stock negativo para este producto y/o ubicación."
