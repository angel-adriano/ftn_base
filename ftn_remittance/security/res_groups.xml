<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_account_treasure" model="res.groups">
        <field name="name">Treasure</field>
        <field name="category_id" ref="base.module_category_accounting_accounting"/>
        <field name="implied_ids" eval="[(4, ref('account.group_account_invoice'))]"/>
    </record>
    <record id="group_account_approver" model="res.groups">
        <field name="name">Aprovador de Remesa</field>
        <field name="category_id" ref="base.module_category_accounting_accounting"/>
        <field name="implied_ids" eval="[(4, ref('ftn_remittance.group_account_treasure'))]"/>
    </record>

    <record id="account.group_account_manager" model="res.groups">
    <field name="implied_ids" eval="[(4, ref('ftn_remittance.group_account_approver'))]"/>
</record>
</odoo>
