<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="account_remittance_export_wizard_view_form" model="ir.ui.view">
        <field name="name">account.remittance.export.wizard.view.form</field>
        <field name="model">account.remittance.export.wizard</field>
        <field name="arch" type="xml">
            <form string="">
                <sheet>
                    <span><strong>Click to download file</strong></span>
                    <group>
                        <field name="export_type" nolabel="1" widget="radio" required="1" invisible="1"/>
                        <field name="filename" nolabel="1" readonly="1" invisible="1"/>
                        <field name="excel_file" nolabel="1" readonly="1" widget="binary" class="oe_inline" filename="filename"/>
                    </group>
                </sheet>
                <footer>
                    <button string="Cancel" class="btn btn-secondary" special="cancel" data-hotkey="z"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
