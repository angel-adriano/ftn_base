<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Account Remittance Line -->
    <record id="account_remittance_line_view_form" model="ir.ui.view">
        <field name="name">account.remittance.line.view.form</field>
        <field name="model">account.remittance.line</field>
        <field name="arch" type="xml">
            <form string="Remittance line">
                <sheet>
                    <group>
                        <group>
                            <field name="invoice_id" />
                            <field name="currency_id" />
                            <field name="amount_total" />
                            <field name="amount_residual" />
                            <field name="amount_to_pay" />
                            <field name="amount_paid" />
                        </group>
                        <group>
                            <field name="name" />
                            <field name="payment_type" />
                            <field name="purchase_id" />
                            <field name="denied_reason" invisible="ready_to_pay == True"/>
                            <field name="ready_to_pay" />
                            <field name="partner_bank_id" />
                        </group>
                        <field name="description" placeholder="Add some description..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Form View -->
    <record id="account_remittance_view_form" model="ir.ui.view">
        <field name="name">account.remittance.view.form</field>
        <field name="model">account.remittance</field>
        <field name="arch" type="xml">
            <form string="">
                <field name="allow_approve" invisible="1"/>
                <header>
                    <field name="approved_done" invisible="1"/>
<!--                    <button string="Generate remittance" name="%(action_open_generate)d" type="action" class="oe_highlight" attrs="{'invisible': [('stage_id','!=', 1), ('line_ids','=', False)]}"/>-->
                    <button string="Confirm" name="action_confirm" type="object" class="oe_highlight" invisible="stage_id != 1 or not line_ids"/>
                    <button string="Approve" name="action_approve" type="object" class="oe_highlight" invisible="approved_done == True or stage_id != 2"/>
                    <button string="Validar Estado SAT" name="update_sat_status" type="object" class="oe_highlight" invisible="stage_id != 3"/>
                    <button string="Register payment" name="action_execute_individual_payments" type="object" class="oe_highlight" invisible="stage_id != 3"/>
                    <button string="Generate TXT" name="action_generate_txt" type="object" class="oe_highlight" invisible="stage_id != 4"/>
                    <button string="Cancel" name="action_cancel" type="object" confirm="¿Desea cancelar la remesa?" class="btn-secondary" invisible="stage_id == 5"/>
                    <button string="XLSX" name="action_export_remittance_invoice_lines" type="object" invisible="stage_id == 1 or line_ids != False"/>
                    <field name="stage_id" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_payments" type="object" class="oe_stat_button" icon="fa-credit-card">
                            <field name="payment_count" widget="statinfo" string="Pagos"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="To approve" bg_color="bg-warning" invisible="stage_id != 2"/>
                    <widget name="web_ribbon" title="Approved" bg_color="bg-warning" invisible="stage_id != 3"/>
                    <widget name="web_ribbon" title="Paid" bg_color="bg-info" invisible="stage_id != 4"/>
                    <widget name="web_ribbon" title="Canceled" bg_color="bg-danger" invisible="stage_id != 5"/>
                    <div class="oe_title">
                        <!-- Number -->
                        <h1 class="mt0" invisible="name == '/'">
                            <field name="name" readonly="'state', '!=', 'draft'" placeholder="Semana 32 P62"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="period" placeholder="Semana 29"/>
                            <field name="project_id"/>
                            <field name="responsible_id"/>
                            <field name="approver_id"/>
                            <field name="payer_id"/>
                        </group>
                        <group>
                            <field name="initial_date" invisible="1"/>
                            <field name="final_date" invisible="1"/>
                            <field name="currency_id"/>
                            <field name="total_mxn" invisible="currency_id != 33"/>
                            <field name="total_usd" invisible="currency_id != 2"/>
                            <field name="remittance_total"/>
                            <field name="tag_ids" widget="many2many_tags"/>
                            <field name="journal_id" domain="[('type', '=', 'bank')]"/>
                            <field name="pay_account"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="invoices" string="Invoices to pay">
                            <field name="state" invisible="1"/>
                            <field name="line_ids"
                                widget="section_and_note_one2many"
                                mode="list">
                                <list string="Items"
                                      decoration-info="amount_residual &lt; amount_total and amount_residual != 0"
                                      decoration-success="amount_residual == 0"
                                      editable="top">
                                    <field name="name" invisible="1"/>
                                    <field name="analytic_account_id" invisible="1"/>
                                    <field name="invoice_id" domain="[('ready_to_pay', '=', True), ('analytic_account_id', '=', analytic_account_id), ('amount_residual', '>', 0)]"/>
                                    <field name="partner_id"/>
                                    <field name="payment_terms" optional="show"/>
                                    <field name="description"/>
                                    <field name="currency_id" optional="hide"/>
                                    <field name="amount_total"/>
                                    <field name="amount_residual"/>
                                    <field name="amount_to_pay"/>
                                    <field name="amount_paid" optional="hide" readonly="1"/>
                                    <field name="purchase_id" optional="show"/>
                                    <field name="ready_to_pay" optional="show"/>
                                    <field name="denied_reason" invisible="ready_to_pay == True" optional="show"/>
                                    <field name="partner_bank_id" optional="show"/>
                                    <field name="comment" />
                                    <field name="estado" invisible="estado == False"/>
                                    <button name="update_sat_status" type="object" icon="fa-check" invisible="estado == True"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter reload_on_attachment="True"/>
            </form>
        </field>
    </record>

    <!-- Kanban View -->    
    <record id="account_remittance_view_kanban" model="ir.ui.view">
        <field name="name">account.remittance.view.kanban</field>
        <field name="model">account.remittance</field>
        <field name="arch" type="xml">
            <kanban js_class="account_remittance_kanban" class="o_account_remittance_kanban" default_group_by="stage_id" sample="1" records_draggable="0" quick_create="true">
                <field name="stage_id"/>
                <field name="currency_id"/>
                <templates>
                    <t t-name="kanban-tooltip">
                       <ul class="oe_kanban_tooltip">
                          <li t-if="record.project_id.raw_value"><b>Partner:</b> <t t-esc="record.project_id.value"/></li>
                          <li t-if="record.user_id.raw_value"><b>Request to:</b> <t t-esc="record.user_id.value"/></li>
                       </ul>
                    </t>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="o_dropdown_kanban dropdown">
                                <a role="button" class="dropdown-toggle o-no-caret btn" data-bs-toggle="dropdown" data-bs-display="static" href="#" aria-label="Dropdown menu" title="Dropdown menu">
                                    <span class="fa fa-ellipsis-v"/>
                                </a>
                                <div class="dropdown-menu" role="menu">
                                    <t t-if="widget.editable"><a role="menuitem" type="edit" class="dropdown-item">Edit...</a></t>
                                    <t t-if="widget.deletable"><a role="menuitem" type="delete" class="dropdown-item">Delete</a></t>
                                </div>
                            </div>
                            <div class="oe_kanban_content" tooltip="kanban-tooltip">
                                <div class="o_kanban_record_top">
                                    <b class="o_kanban_record_title"><field name="name"/></b>
                                </div>
                                 <div class="o_kanban_record_subtitle">
                                     <span name="project_id" t-if="record.project_id.raw_value">Project: <field name="project_id"/><br/></span>
                                     <span name="responsible_id" t-if="record.responsible_id.raw_value">Prepared by: <field name="responsible_id"/><br/></span>
                                     <span name="total" t-if="record.remittance_total.raw_value">Total: <field name="remittance_total" widget="monetary" options="{'currency_field': 'currency_id'}"/><br/></span>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <!-- <field name="priority" widget="priority"/> -->
                                        <div class="o_kanban_inline_block ml4 mr4">
                                            <field name="activity_ids" widget="kanban_activity" />
                                        </div>
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <!-- <field name="kanban_state" widget="state_selection"/> -->
                                        <field name="user_id" widget="many2one_avatar_user"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Actions -->
    <record id="action_remittances" model="ir.actions.act_window">
        <field name="name">Remittances</field>
        <field name="res_model">account.remittance</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p>
                Add new record
            </p>
        </field>
    </record>

    <!-- Menus -->
    <menuitem
        id="remittances_menu"
        name="Remesas"
        action="action_remittances"
        parent="account.menu_finance_payables"
        sequence="0"/>

    <record id="view_move_inherit_form1" model="ir.ui.view">
        <field name="name">view.move.inherit.form1</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="match_supplier_xml" type="object" class="oe_highlight" string="Conciliar XML" invisible="state != 'posted' or uuid_reconciled == True or move_type != 'in_invoice'"/>
            </xpath>
            <xpath expr="//field[@name='ref']" position="after">
                <field name="supplier_uuid" invisible="move_type != 'in_invoice'" readonly="uuid_reconciled != False"/>
                <field name="ready_to_pay" widget="boolean_toggle" invisible="move_type != 'in_invoice' or state == 'draft'"/>
            </xpath>
            <xpath expr="//div[@name='journal_div']" position="after">
                <field name="uuid_reconciled" invisible="move_type != 'in_invoice'" readonly="1"/>
            </xpath>
        </field>
    </record>

</odoo>
