<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_receive_purchase_order_lines_form" model="ir.ui.view">
        <field name="name">receive.purchase.order.lines.form</field>
        <field name="model">receive.purchase.order.lines</field>
        <field name="arch" type="xml">
            <form string="Receive Purchase Order Lines">
                <sheet>
                    <group>
                        <field name="purchase_order_id" readonly="1"/>
                    </group>
                    <div>
                        <field name="line_ids" nolabel ="1">
                            <tree editable="bottom" create='false'>
                                <field name="purchase_order_line_id" invisible="1"/>
                                <field name="product_id"/>
                                <field name="product_uom" />
                                <field name="qty_ordered" />
                                <field name="qty_received" />
                                <field name="qty_to_receive"/>
                            </tree>
                        </field>
                    </div>
                </sheet>
                <footer>
                    <button string="Receive" type="object" name="action_receive_lines" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>


</odoo>