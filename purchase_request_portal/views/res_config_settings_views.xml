<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Settings view -->
        <record id="res_config_settings_view_form_inherit" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.purchase.request.portal</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="purchase.res_config_settings_view_form_purchase"/>
            <field name="arch" type="xml">
                <xpath expr="//block[@name='purchase_setting_container']" position="after">
                    <block id="purchase_request_portal_settings" title="Purchase Request Portal">
                        <setting string="Purchase Request Approver Configuration"
                                 help="Configure how purchase requests from the portal are assigned for approval">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="approver_type" string="Approver Type" class="col-lg-3 o_light_label"/>
                                    <field name="approver_type" class="oe_inline"/>
                                </div>
                                <div class="row mt16">
                                    <label for="purchase_request_notification_user_id"
                                           string="Fixed Approver / Notification User"
                                           class="col-lg-3 o_light_label"/>
                                    <field name="purchase_request_notification_user_id"
                                           class="oe_inline"
                                           domain="[('active', '=', True)]"
                                           options="{'no_create': True}"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
