<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- FORM VIEW  -->
    <record id="view_transientmodel_wizard_form" model="ir.ui.view">
        <field name="name">transient.form</field>
        <field name="model">create.purchaseorder</field>
        <field name="arch" type="xml">
            <form string="Sale Order">
                <p class="oe_grey"></p>
                <group>
                    <group>
                        <field name="partner_id" />
                        <field name="has_draft_orders" invisible="1"/>
                        <field name="existing_order_id"
                               invisible="has_draft_orders == False"
                               options="{'no_create': True, 'no_edit': True}"/>
                    </group>
                    <group>
                        <field name="date_order" />
                    </group>
                </group>
                <div class="alert alert-info" invisible="has_draft_orders == False">
                    <strong>Aviso:</strong> El proveedor seleccionado tiene ordenes en borrador.
                    Puedes seleccionar una orden para agregar los productos o dejarlo en blanco para crear una nueva.
                </div>
                <br></br>
                <div>
                    <field name="new_order_line_ids" nolabel="1">
                        <list editable="bottom" create="false">
                            <field name="product_id" />
                            <field name="name" />
                            <field name="product_qty" />
                            <field name="product_uom" class="oe_inline"/>
                        </list>
                    </field>
                </div>
                <footer>
                    <button name="action_create_purchase_order" string="Crear" type="object" class="btn-primary"
                            invisible="existing_order_id != False"/>
                    <button name="action_create_purchase_order" string="Agregar" type="object" class="btn-primary"
                            invisible="existing_order_id == False"/>
                    <button string="Cancel" class="btn-default" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- ACTION     -->
    <record id="action_transientmodel_wizard" model="ir.actions.act_window">
        <field name="name">Create Purchase Order</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">create.purchaseorder</field>
        <field name="binding_view_types">form</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>