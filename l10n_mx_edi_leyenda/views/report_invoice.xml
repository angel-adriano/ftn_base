<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <template id="report_invoice_document_mx" inherit_id="l10n_mx_edi.report_invoice_document_mx">

            <!-- External Trade stuff -->
            <xpath expr="//div[@id='complement']" position="before">
                <div t-if="is_cfdi_signed and o.leyenda">
                    <div class="row">
                        <div class="col-12">
                            <div align="center">
                                <span><strong>Complemento leyenda</strong></span>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-12">
                            <table class="table table-sm text-center mt4 mb4" align="center" style="font-size:10px">
                                <thead>
                                    <tr style="background-color:grey; color:white;">
                                        <th class="text-center">Disposición FIscal</th>
                                        <th class="text-center">Norma</th>
                                        <th class="text-center">Texto leyenda</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td><span t-esc="cfdi_vals['disposicionFiscal']"/></td>
                                        <td><span t-esc="cfdi_vals['norma']"/></td>
                                        <td><span t-esc="cfdi_vals['textoLeyenda']"/></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </xpath>
        </template>

    </data>
</odoo>
