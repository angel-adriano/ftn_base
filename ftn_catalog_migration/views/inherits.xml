<odoo>
    <record id="view_product_template_form_inherit_import_price" model="ir.ui.view">
        <field name="name">product.template.import.price.button</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//form//header" position="inside">
                <button name="import_price_from_odoo14"
                        type="object"
                        string="Odoo14 Details"
                        class="btn-primary"/>
            </xpath>
        </field>
    </record>

    <record id="view_Product_image_import" model="ir.ui.view">
        <field name="name">Product.image.form.custom</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general_information']//group" position="inside">
                <!-- <xpath expr="//form//field[@name='image_1920']" position="after"> -->
                <group>
                    <field class="o_field_widget" name="image_url" string="Product Image Url"/>
<!--                    <field name="image_variant_1920" widget="image"/>-->
                </group>

            </xpath>
        </field>
    </record>
</odoo>