<odoo>
    <record id="view_product_template_form_inherit_import_price" model="ir.ui.view">
        <field name="name">product.template.import.price.button</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//form//header" position="inside">
                <button name="import_price_from_odoo14"
                        type="object"
                        string="Odoo14 Details"
                        class="btn-primary"/>
            </xpath>
        </field>
    </record>
</odoo>