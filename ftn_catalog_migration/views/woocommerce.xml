<odoo>
    <record id="view_import_products_wizard_form" model="ir.ui.view">
        <field name="name">import.products.wizard.form</field>
        <field name="model">import.products.wizard</field>
        <field name="arch" type="xml">
            <form string="Import WooCommerce Products">
                <group>
                    <div>Sincronizar productos creados</div>
                    <field name="sync_date"/>
                </group>

                <footer>
                    <button string="Import Products" type="object" name="import_woocommerce_products"
                            class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_import_products_wizard" model="ir.actions.act_window">
        <field name="name">Retrieve Products</field>
        <field name="res_model">import.products.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_retrieve_woocommerce" parent="menu_data_migration_root" name="Retrieve Products (WC)"
              action="action_import_products_wizard" sequence="40"/>

</odoo>
